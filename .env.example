# ==============================================================================
# NEXUS AI Configuration Template
# Everything runs completely offline with zero API keys required.
# ==============================================================================

# --- Simulation Clock ---
# Real-time seconds per simulated tick (default: 0.6s real = 15s simulated -> 25x speed)
NEXUS_WALL_SECONDS=0.6
NEXUS_TICK_SECONDS=15.0
NEXUS_WARMUP_TICKS=6240
NEXUS_BUFFER_TICKS=720

# --- Anomaly Detector ---
NEXUS_HARMONICS=3
NEXUS_DETECT_QUANTILE=0.995
NEXUS_PERSIST_K=3
NEXUS_PERSIST_N=5

# --- Optional LLM Narration ---
# Options: auto | deterministic | openai | anthropic | ollama
NEXUS_LLM_PROVIDER=auto

# Optional OpenAI Provider
# NEXUS_OPENAI_API_KEY=sk-...
# NEXUS_OPENAI_MODEL=gpt-4.1-mini
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Anthropic Provider
# NEXUS_ANTHROPIC_API_KEY=sk-ant-...
# NEXUS_ANTHROPIC_MODEL=claude-sonnet-5

# Optional Local Ollama Provider
# NEXUS_OLLAMA_BASE_URL=http://localhost:11434
# NEXUS_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Benchmark & Evaluation ---
NEXUS_EVAL_SEEDS_PER_SCENARIO=12
NEXUS_EVAL_CLEAN_EPISODES=24
NEXUS_CV_FOLDS=4

# --- Networking ---
NEXUS_API_PORT=8000
NEXUS_WEB_PORT=3000
